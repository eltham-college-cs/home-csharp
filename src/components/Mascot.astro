---
// Hash the hedgehog, the C# at Home mascot. Spines are sharp (C sharp), and the # on the
// tummy is a "hash". Moods: idle | happy | tryagain. Animated with CSS classes only, so
// prefers-reduced-motion switches everything off. Change mood with setMood() from
// src/lib/mascot.ts.
import { mascotLabels, type Mood } from '../lib/mascot';

interface Props {
  mood?: Mood;
  size?: number;
  class?: string;
  /** Hide from screen readers when the text next to Hash already says it all. */
  decorative?: boolean;
}
const { mood = 'idle', size = 210, class: cls = '', decorative = false } = Astro.props;
---

<svg
  class:list={['mascot', cls]}
  data-mood={mood}
  width={size}
  height={size}
  viewBox="0 0 200 200"
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : mascotLabels[mood]}
  aria-hidden={decorative ? 'true' : undefined}
  focusable="false"
>
  <ellipse cx="100" cy="190" rx="58" ry="7" fill="#0A1B2E" opacity="0.12"></ellipse>

  <g class="m-sparkles m-happy">
    <path d="M28 40 l3 8 8 3 -8 3 -3 8 -3 -8 -8 -3 8 -3 Z" fill="#F2B533"></path>
    <path d="M172 34 l2.5 6.5 6.5 2.5 -6.5 2.5 -2.5 6.5 -2.5 -6.5 -6.5 -2.5 6.5 -2.5 Z" fill="#2F7DD1"></path>
    <path d="M182 92 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2 Z" fill="#F2B533"></path>
    <path d="M16 96 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2 Z" fill="#2F7DD1"></path>
  </g>

  <g class="m-body">
    <!-- Feet -->
    <ellipse cx="78" cy="182" rx="15" ry="8" fill="#FCE9BE" stroke="#0A1B2E" stroke-width="4"></ellipse>
    <ellipse cx="122" cy="182" rx="15" ry="8" fill="#FCE9BE" stroke="#0A1B2E" stroke-width="4"></ellipse>

    <!-- Spines (sharp!) -->
    <polygon
      points="41.7,133.2 15.7,129.2 38.1,115.3 14.4,103.9 39.8,97.2 20.4,79.4 46.7,80.3 33.4,57.6 58.3,66.1 52.1,40.6 73.4,56.0 75.0,29.7 90.9,50.7 100.0,26.0 109.1,50.7 125.0,29.7 126.6,56.0 147.9,40.6 141.7,66.1 166.6,57.6 153.3,80.3 179.6,79.4 160.2,97.2 185.6,103.9 161.9,115.3 184.3,129.2 158.3,133.2"
      fill="#163351"
      stroke="#0A1B2E"
      stroke-width="4"
      stroke-linejoin="round"></polygon>
    <ellipse cx="100" cy="122" rx="64" ry="62" fill="#163351" stroke="#0A1B2E" stroke-width="4"></ellipse>
    <path
      d="M58 78 l6 10 M80 62 l3 11 M120 62 l-3 11 M142 78 l-6 10 M44 104 l10 5 M156 104 l-10 5"
      stroke="#2A5A8C"
      stroke-width="4"
      stroke-linecap="round"></path>

    <!-- Ears -->
    <circle cx="66" cy="84" r="11" fill="#FCE9BE" stroke="#0A1B2E" stroke-width="4"></circle>
    <circle cx="66" cy="84" r="5" fill="#F4A7B5"></circle>
    <circle cx="134" cy="84" r="11" fill="#FCE9BE" stroke="#0A1B2E" stroke-width="4"></circle>
    <circle cx="134" cy="84" r="5" fill="#F4A7B5"></circle>

    <!-- Face and tummy -->
    <path
      d="M100 82 C 132 82, 148 106, 148 136 C 148 166, 128 182, 100 182 C 72 182, 52 166, 52 136 C 52 106, 68 82, 100 82 Z"
      fill="#FCE9BE"
      stroke="#0A1B2E"
      stroke-width="4"></path>

    <!-- The hash on the tummy -->
    <g stroke-linecap="round">
      <path d="M95 151 L92 175 M107 151 L104 175 M86 159 L113 159 M84 168 L111 168" stroke="#0A1B2E" stroke-width="9"></path>
      <path d="M95 151 L92 175 M107 151 L104 175 M86 159 L113 159 M84 168 L111 168" stroke="#F2B533" stroke-width="4.5"></path>
    </g>

    <!-- Arms: resting, both up (happy), one fist pumping (try again) -->
    <g class="m-arm-left m-not-happy">
      <ellipse cx="54" cy="150" rx="9" ry="14" transform="rotate(20 54 150)" fill="#FCE9BE" stroke="#0A1B2E" stroke-width="4"></ellipse>
    </g>
    <g class="m-arm-right m-idle">
      <ellipse cx="146" cy="150" rx="9" ry="14" transform="rotate(-20 146 150)" fill="#FCE9BE" stroke="#0A1B2E" stroke-width="4"></ellipse>
    </g>
    <g class="m-arms-up m-happy">
      <ellipse cx="44" cy="112" rx="9" ry="15" transform="rotate(-35 44 112)" fill="#FCE9BE" stroke="#0A1B2E" stroke-width="4"></ellipse>
      <ellipse cx="156" cy="112" rx="9" ry="15" transform="rotate(35 156 112)" fill="#FCE9BE" stroke="#0A1B2E" stroke-width="4"></ellipse>
    </g>
    <g class="m-fist m-try">
      <ellipse cx="156" cy="118" rx="11" ry="11" fill="#FCE9BE" stroke="#0A1B2E" stroke-width="4"></ellipse>
      <path d="M170 100 l7 -6 M174 114 l9 0 M164 92 l3 -8" stroke="#2F7DD1" stroke-width="3" stroke-linecap="round"></path>
    </g>

    <!-- Face -->
    <g class="m-face">
      <circle cx="70" cy="132" r="7" fill="#F4A7B5" opacity="0.75"></circle>
      <circle cx="130" cy="132" r="7" fill="#F4A7B5" opacity="0.75"></circle>

      <g class="m-eyes m-not-happy">
        <ellipse cx="82" cy="112" rx="9" ry="11" fill="#fff" stroke="#0A1B2E" stroke-width="3"></ellipse>
        <ellipse cx="118" cy="112" rx="9" ry="11" fill="#fff" stroke="#0A1B2E" stroke-width="3"></ellipse>
        <circle cx="84" cy="114" r="5.5" fill="#0A1B2E"></circle>
        <circle cx="120" cy="114" r="5.5" fill="#0A1B2E"></circle>
        <circle cx="86" cy="111" r="2" fill="#fff"></circle>
        <circle cx="122" cy="111" r="2" fill="#fff"></circle>
      </g>
      <path class="m-happy" d="M73 115 Q 82 104 91 115 M109 115 Q 118 104 127 115" fill="none" stroke="#0A1B2E" stroke-width="4" stroke-linecap="round"></path>
      <path class="m-try" d="M72 97 L 91 102 M128 97 L 109 102" stroke="#0A1B2E" stroke-width="4" stroke-linecap="round"></path>

      <ellipse cx="100" cy="128" rx="7" ry="5" fill="#0A1B2E"></ellipse>
      <circle cx="98" cy="126.5" r="1.6" fill="#fff"></circle>

      <path class="m-idle" d="M90 137 Q 100 146 110 137" fill="none" stroke="#0A1B2E" stroke-width="3.5" stroke-linecap="round"></path>
      <g class="m-happy">
        <path d="M86 135 Q 100 157 114 135 Z" fill="#0A1B2E" stroke="#0A1B2E" stroke-width="2" stroke-linejoin="round"></path>
        <path d="M93 145 Q 100 140 107 145 Q 100 152 93 145 Z" fill="#E8788F"></path>
      </g>
      <path class="m-try" d="M89 140 Q 102 145 112 135" fill="none" stroke="#0A1B2E" stroke-width="3.5" stroke-linecap="round"></path>
    </g>
  </g>
</svg>

<style is:global>
  .mascot {
    overflow: visible;
    flex: none;
  }
  .mascot .m-happy,
  .mascot .m-try {
    display: none;
  }
  .mascot[data-mood='happy'] .m-happy,
  .mascot[data-mood='tryagain'] .m-try {
    display: inline;
  }
  .mascot[data-mood='happy'] .m-not-happy,
  .mascot:not([data-mood='idle']) .m-idle {
    display: none;
  }

  .mascot .m-body,
  .mascot .m-eyes,
  .mascot .m-arms-up,
  .mascot .m-fist {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .mascot .m-eyes {
    transform-origin: 50% 50%;
  }
  .mascot .m-fist {
    transform-origin: 0% 100%;
  }

  @keyframes m-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }
  @keyframes m-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @keyframes m-blink {
    0%, 92%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }
  @keyframes m-wave {
    0%, 100% { transform: rotate(-4deg); }
    50% { transform: rotate(4deg); }
  }
  @keyframes m-pump {
    0%, 100% { transform: rotate(0); }
    50% { transform: rotate(-14deg); }
  }
  @keyframes m-sparkle {
    0%, 100% { opacity: 0.15; }
    50% { opacity: 1; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .mascot[data-mood='idle'] .m-body { animation: m-bob 4s ease-in-out infinite; }
    .mascot[data-mood='idle'] .m-eyes { animation: m-blink 5s infinite; }
    .mascot[data-mood='happy'] .m-body { animation: m-bounce 0.7s ease-in-out 3; }
    .mascot[data-mood='happy'] .m-arms-up { animation: m-wave 0.7s ease-in-out 3; }
    .mascot[data-mood='happy'] .m-sparkles path { animation: m-sparkle 1.2s ease-in-out infinite; }
    .mascot[data-mood='happy'] .m-sparkles path:nth-child(2) { animation-delay: 0.4s; }
    .mascot[data-mood='happy'] .m-sparkles path:nth-child(3) { animation-delay: 0.8s; }
    .mascot[data-mood='tryagain'] .m-fist { animation: m-pump 0.9s ease-in-out 3; }
    .mascot[data-mood='tryagain'] .m-eyes { animation: m-blink 5s infinite; }
  }
</style>
