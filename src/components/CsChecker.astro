  /* Celebration burst */
  .burst {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .burst span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    animation: pop 1.1s cubic-bezier(0.2, 0.7, 0.4, 1) forwards;
  }
  @keyframes pop {
    0% {
      transform: translate(0, 0) scale(0.3);
      opacity: 1;
