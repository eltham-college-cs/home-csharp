---
// Code editor with Run and Check. Checking matches CodeBash (SPEC § 7).
// Use in a lesson as <CsChecker task="task-id" /> (an id from the lesson's tasks.json)
// or pass the task object itself.
import Mascot from './Mascot.astro';
import { highlightHtml } from '../lib/highlight';
import { dots } from '../lib/render-diff';
import type { Task } from '../lib/lessons';

interface Props {
  task: string | Task;
  /** A question to answer before pressing Run. */
  predict?: string;
  /** What to build, shown beside the editor. */
  brief?: string;
}
const { task: taskProp, predict, brief } = Astro.props;
const lesson = Astro.locals.lesson;
const task: Task | undefined =
  typeof taskProp === 'string' ? lesson?.tasks.find((t) => t.id === taskProp) : taskProp;
if (!task) throw new Error(`CsChecker: no task "${String(taskProp)}" in ${lesson?.id ?? 'this lesson'}'s tasks.json`);

const uid = `${lesson?.id.replace(/[^a-z0-9]+/gi, '-') ?? 'x'}-${task.id}`;
const theBrief = brief ?? task.brief;
const inputsText = (s: string) => s.split('\n').join(', then ');
const payload = JSON.stringify({ id: uid, starter: task.starter, tests: task.tests, hints: task.hints ?? {} });
---

<div class="checker" data-checker={payload}>
  <div class="checker-grid">
    <div class="editor-card">
      <div class="editor-bar">
        <span class="file-dot" aria-hidden="true"></span>
        <span>Program.cs</span>
        <span class="task-name">{task.title}</span>
      </div>
      <div class="editor">
        <div class="editor-stack">
          <pre class="editor-hl" aria-hidden="true"><code set:html={highlightHtml(task.starter) + '\n'} /></pre>
          <textarea
            class="editor-input"
            id={`code-${uid}`}
            spellcheck="false"
            autocapitalize="off"
            autocomplete="off"
            autocorrect="off"
            wrap="off"
            aria-label={`C# code: ${task.title}`}
            aria-describedby={`help-${uid}`}>{task.starter}</textarea
          >
        </div>
      </div>
      <div class="editor-actions">
        <button type="button" class="btn btn-light" data-run>▶ Run</button>
        <button type="button" class="btn btn-gold pulse" data-check>✓ Check my code</button>
        <button type="button" class="btn btn-ghost" data-reset>Start again</button>
      </div>
      <p class="editor-help" id={`help-${uid}`}>
        <span data-status>C# loads the first time you press Run.</span>
        <span class="load-bar" hidden role="progressbar" aria-label="Loading C#" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></span>
        <span class="kbd-tip">Tab adds 4 spaces. Press Esc, then Tab, to leave the code box.</span>
      </p>
      <div class="console" hidden>
        <div class="console-head">
          <span>Output</span>
          <button type="button" class="console-clear" data-clear>Clear</button>
        </div>
        <div class="console-body" role="log" aria-live="polite"></div>
      </div>
    </div>

    <div class="side">
      {
        theBrief && (
          <div class="brief">
            <span class="side-label">Your task</span>
            <p set:html={theBrief} />
          </div>
        )
      }
      {
        predict && (
          <div class="predict">
            <label for={`predict-${uid}`}>{predict}</label>
            <input id={`predict-${uid}`} type="text" placeholder="Write your prediction" autocomplete="off" />
            <p class="muted small">Grown-up: ask "why?" before they press Run.</p>
          </div>
        )
      }
      <details class="tests" open={!predict}>
        <summary>What the checker will try</summary>
        <ul>
          {
            task.tests.map((t) => (
              <li>
                {t.input ? (
                  <>
                    You type <strong class="out">{inputsText(t.input)}</strong>.<br />
                    It should print:
                  </>
                ) : (
                  <>It should print:</>
                )}
                <span class="out expected-out" set:html={dots(t.output).replace(/\n/g, '<br>')} />
              </li>
            ))
          }
        </ul>
        <p class="muted small">Dots show spaces. Every space, capital letter and full stop must match.</p>
      </details>
    </div>
  </div>

  <div class="results" aria-live="polite"></div>
  <template class="mascot-tpl"><Mascot mood="idle" size={170} decorative /></template>
</div>

<style is:global>
  .checker {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .checker-grid {
    display: flex;
    flex-wrap: wrap;
