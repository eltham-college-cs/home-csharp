</style>

<script>
  import { runCSharp, warmUp, onStatus, onProgress } from '../lib/cs';
  import { classify, defaultHints, programOutput, type HintCategory, type RunResult } from '../lib/compare';
  import { renderGot, renderLines, dots } from '../lib/render-diff';
  import { highlightHtml } from '../lib/highlight';
  import { findError } from '../data/errors';
  import { setMood, MASCOT_NAME } from '../lib/mascot';
  import { celebrate } from './Celebrate';
  import { url } from '../lib/url';

  type Test = { input: string; output: string };
  type Data = { id: string; starter: string; tests: Test[]; hints: Partial<Record<string, string>> };

  const store = {
    get(k: string) {
      try {
        return localStorage.getItem(k);
      } catch {
        return null;
      }
    },
    set(k: string, v: string) {
      try {
        localStorage.setItem(k, v);
      } catch {}
    },
    remove(k: string) {
      try {
        localStorage.removeItem(k);
      } catch {}
    },
  };

  const LOAD_FAILED = "C# couldn't load. Check your internet connection, then reload the page.";
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const inputsOf = (t: Test) => (t.input === '' ? [] : t.input.split('\n'));

  function errorHtml(r: RunResult): string {
    if (r.timeout) {
      return `<span class="run-error">Your program didn't finish. Is something repeating forever? <a href="${url('/error-decoder/#never-finished')}">How to fix it</a></span>`;
    }
    if (!r.error) return '';
    const e = r.error;
    const entry = findError(e.type, e.message);
    const link = entry ? ` <a href="${url(`/error-decoder/#${entry.id}`)}">What does this mean?</a>` : '';
    if (e.compile) {
      const more = e.more ? ` (and ${e.more} more ${e.more === 1 ? 'error' : 'errors'} after it)` : '';
      return `<span class="run-error">Your code didn't build. Line ${e.line}: ${esc(e.type)} ${esc(e.message)}${more}${link}</span>`;
    }
    const where = e.line ? ` on line ${e.line}` : '';
    return `<span class="run-error">${esc(e.type)}${where}: ${esc(e.message)}${link}</span>`;
  }

  function setup(root: HTMLElement) {
    const data: Data = JSON.parse(root.dataset.checker!);
    const textarea = root.querySelector<HTMLTextAreaElement>('.editor-input')!;
    const hl = root.querySelector<HTMLElement>('.editor-hl code')!;
    const runBtn = root.querySelector<HTMLButtonElement>('[data-run]')!;
    const checkBtn = root.querySelector<HTMLButtonElement>('[data-check]')!;
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
    const consoleEl = root.querySelector<HTMLElement>('.console')!;
    const consoleBody = root.querySelector<HTMLElement>('.console-body')!;
    const results = root.querySelector<HTMLElement>('.results')!;
    const tpl = root.querySelector<HTMLTemplateElement>('.mascot-tpl')!;
    const key = `pah:code:${data.id}`;
    let escaped = false;
    let busy = false;

    const paint = () => {
      hl.innerHTML = highlightHtml(textarea.value) + '\n';
    };
    const saved = store.get(key);
    if (saved !== null && saved !== data.starter) {
      textarea.value = saved;
      paint();
    }

    let saveTimer = 0;
    textarea.addEventListener('input', () => {
      paint();
      window.clearTimeout(saveTimer);
      saveTimer = window.setTimeout(() => store.set(key, textarea.value), 300);
    });

    const insert = (text: string) => {
      textarea.focus();
      if (!document.execCommand('insertText', false, text)) {
        textarea.setRangeText(text, textarea.selectionStart, textarea.selectionEnd, 'end');
        textarea.dispatchEvent(new Event('input'));
      }
    };

    textarea.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        escaped = true;
        return;
      }
      const { selectionStart: s, selectionEnd: end, value } = textarea;
      const lineStart = value.lastIndexOf('\n', s - 1) + 1;
      if (e.key === 'Tab' && !escaped) {
        e.preventDefault();
        if (e.shiftKey) {
          const spaces = value.slice(lineStart).match(/^ {1,4}/)?.[0].length ?? 0;
          if (spaces) {
            textarea.setSelectionRange(lineStart, lineStart + spaces);
            insert('');
            const pos = Math.max(lineStart, s - spaces);
            textarea.setSelectionRange(pos, Math.max(pos, end - spaces));
          }
        } else insert('    ');
        return;
      }
      escaped = false;
      if (e.key === 'Enter' && !e.shiftKey && !e.ctrlKey && !e.metaKey) {
        e.preventDefault();
        const line = value.slice(lineStart, s);
        let indent = line.match(/^ */)![0];
        if (/\{\s*$/.test(line)) indent += '    ';
        insert('\n' + indent);
        return;
      }
      // Typing } on an indented, otherwise empty line moves it back one level.
      if (e.key === '}' && s === end && s > lineStart) {
        const before = value.slice(lineStart, s);
        if (/^ +$/.test(before) && before.length >= 4) {
          e.preventDefault();
          textarea.setSelectionRange(s - 4, s);
          insert('}');
          return;
        }
      }
      if (e.key === 'Backspace' && s === end && s > lineStart) {
        const before = value.slice(lineStart, s);
        if (/^ +$/.test(before) && before.length % 4 === 0) {
          e.preventDefault();
          textarea.setSelectionRange(s - 4, s);
          insert('');
        }
      }
    });

    resetBtn.addEventListener('click', () => {
      textarea.value = data.starter;
      store.remove(key);
      paint();
      results.innerHTML = '';
      consoleEl.hidden = true;
      consoleBody.innerHTML = '';
      setMood(document.querySelector('.hero'), 'idle');
      textarea.focus();
    });

    root.querySelector('[data-clear]')!.addEventListener('click', () => {
      consoleBody.innerHTML = '';
      consoleEl.hidden = true;
      runBtn.focus();
    });

    const bar = root.querySelector<HTMLElement>('.load-bar')!;
    const fill = bar.firstElementChild as HTMLElement;
    const mb = (bytes: number) => (bytes / 2 ** 20).toFixed(1);

    onStatus((s) => {
      if (s === 'loading' && root.dataset.started) statusEl.textContent = 'Getting C# ready…';
      if (s === 'ready' && root.dataset.started) statusEl.textContent = 'C# is ready.';
      if (s === 'failed') statusEl.textContent = LOAD_FAILED;
      if (s !== 'loading') bar.hidden = true;
    });

    // The first visit downloads about 6.5 MB, so show how far it has got.
    onProgress((p) => {
      if (!root.dataset.started) return;
      let pct = 0;
      if (p.stage === 'starting') {
        pct = 100;
        statusEl.textContent = 'Starting C#…';
      } else if (p.total) {
        pct = Math.min(99, Math.floor((p.loaded / p.total) * 100));
        statusEl.textContent = `Getting C# ready… ${mb(p.loaded)} of ${mb(p.total)} MB`;
      } else statusEl.textContent = 'Getting C# ready…';
      bar.hidden = false;
      fill.style.width = `${pct}%`;
      bar.setAttribute('aria-valuenow', String(pct));
    });

    const setBusy = (on: boolean, label = '') => {
      busy = on;
      runBtn.disabled = on;
      checkBtn.disabled = on;
      if (label) statusEl.textContent = label;
    };

    const start = () => {
      root.dataset.started = '1';
      warmUp().catch(() => {});
    };
    root.addEventListener('focusin', start, { once: true });
    root.addEventListener('pointerenter', start, { once: true });

    // ---- Run: interactive, asks for input in the output panel ----
    let inputs: string[] = [];
    let seed = 1;

    async function run() {
      if (busy) return;
      setBusy(true, 'Running…');
      let r: RunResult;
      try {
        r = await runCSharp(textarea.value, inputs, 'run', seed);
      } catch {
        setBusy(false, LOAD_FAILED);
        return;
      }
      setBusy(false, 'C# is ready.');
      consoleEl.hidden = false;
      const parts = r.segments.map((s) =>
        s.kind === 'in' ? `<span class="typed">${esc(s.text)}</span>` : esc(s.text),
      );
      let html = parts.join('');
      if (r.needInput) {
        consoleBody.innerHTML = html;
        const box = document.createElement('div');
        box.className = 'console-input';
        const id = `in-${data.id}-${inputs.length}`;
        box.innerHTML = `<label for="${id}">Your program is waiting. Type an answer and press Enter:</label><input id="${id}" type="text" autocomplete="off" autocapitalize="off" spellcheck="false">`;
        consoleBody.appendChild(box);
        const field = box.querySelector('input')!;
        field.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            inputs.push(field.value);
            run();
          }
        });
        field.focus();
        consoleBody.scrollTop = consoleBody.scrollHeight;
        return;
      }
      if (!r.segments.length && !r.error && !r.timeout) html = '<span class="run-note">Your program finished without printing anything.</span>';
      consoleBody.innerHTML = html + errorHtml(r);
      if (!r.error && !r.timeout && r.segments.length) consoleBody.insertAdjacentHTML('beforeend', '<span class="run-note">Finished. Now press Check my code.</span>');
      consoleBody.scrollTop = consoleBody.scrollHeight;
    }

    runBtn.addEventListener('click', () => {
      start();
      inputs = [];
      seed = Math.floor(Math.random() * 1e6);
      run();
    });

    // ---- Check: every test, compared exactly ----
    checkBtn.addEventListener('click', async () => {
      if (busy) return;
      start();
      setBusy(true, 'Checking…');
      const outcomes: { test: Test; result: RunResult; category: HintCategory }[] = [];
      try {
        for (const test of data.tests) {
          // After one timeout the rest would time out too, so stop waiting.
          if (outcomes.some((o) => o.category === 'timeout')) {
            outcomes.push({ test, result: { segments: [], error: null, timeout: true }, category: 'timeout' });
            continue;
          }
          // Code that doesn't build fails every test the same way.
          const broken = outcomes.find((o) => o.category === 'compile');
          if (broken) {
            outcomes.push({ ...broken, test });
            continue;
          }
          const result = await runCSharp(textarea.value, inputsOf(test), 'test');
          outcomes.push({ test, result, category: classify(test.output, result) });
        }
      } catch {
        setBusy(false, LOAD_FAILED);
        return;
      }
      setBusy(false, 'C# is ready.');
      showResults(outcomes);
    });

    function showResults(outcomes: { test: Test; result: RunResult; category: HintCategory }[]) {
      const n = outcomes.length;
      const passed = outcomes.filter((o) => o.category === 'pass').length;
      const allPass = passed === n;
      const first = outcomes.find((o) => o.category !== 'pass');
      const bars = outcomes.map((o) => `<span class="${o.category === 'pass' ? '' : 'no'}"></span>`).join('');

      let title: string;
      let body = '';
      if (allPass) {
        title = n === 1 ? 'Test passed. Well done!' : `All ${n} tests passed. Well done!`;
        const shown = programOutput(outcomes[0].result.segments);
        body = `<div class="out-box">${renderLines(shown)}</div>
          <p>Every space, capital letter and full stop matched. That's exactly what CodeBash checks too.</p>`;
      } else {
        const o = first!;
        const cat = o.category as Exclude<HintCategory, 'pass'>;
        // Encouraging wording: the course is for students who find programming hard.
        title =
          cat === 'error' || cat === 'timeout' || cat === 'compile'
            ? passed
              ? `Nearly: ${passed} of ${n} tests passed.`
              : "Let's fix this together."
            : passed
              ? `So close: ${passed} of ${n} tests passed.`
              : `Not quite yet: 0 of ${n} tests passed.`;

        const typed = o.test.input
          ? `<p class="test-said">Test ${outcomes.indexOf(o) + 1}: the checker typed <strong class="out">${dots(o.test.input.split('\n').join(', then '))}</strong></p>`
          : `<p class="test-said">Test ${outcomes.indexOf(o) + 1}</p>`;
        let hint = data.hints[cat] ?? defaultHints[cat];
        let detail = '';
        if (cat === 'compile' && o.result.error) {
          const e = o.result.error;
          const entry = findError(e.type, e.message);
          if (!data.hints.compile && entry) hint = entry.meaning;
          const more = e.more ? `<p>There ${e.more === 1 ? 'is 1 more error' : `are ${e.more} more errors`} after this one. Fix this one first: the others often disappear with it.</p>` : '';
          detail = `<p>Your code didn't build. The first problem is on line ${e.line}:</p>
            <div class="error-code">${esc(e.type)}: ${esc(e.message)}</div>${more}
            ${entry ? `<p><a href="${url(`/error-decoder/#${entry.id}`)}">Open the error decoder: ${esc(entry.name)}</a></p>` : ''}`;
        } else if (cat === 'error' && o.result.error) {
          const e = o.result.error;
          const entry = findError(e.type, e.message);
          if (!data.hints.error && entry) hint = entry.meaning;
          detail = `<p>Your program stopped${e.line ? ` on line ${e.line}` : ''}:</p>
            <div class="error-code">${esc(e.type)}: ${esc(e.message)}</div>
            ${entry ? `<p><a href="${url(`/error-decoder/#${entry.id}`)}">Open the error decoder: ${esc(entry.name)}</a></p>` : ''}`;
        } else if (cat === 'timeout') {
          detail = `<p><a href="${url('/error-decoder/#never-finished')}">How to fix a loop that never ends</a></p>`;
        } else {
          const got = programOutput(o.result.segments);
          detail = `<div class="compare">
              <span>Expected</span><div class="out-box">${renderLines(o.test.output)}</div>
              <span>You got</span><div class="out-box">${renderGot(o.test.output, got)}</div>
            </div>`;
        }
        body = `${typed}${detail}
          <div class="hint-box"><span class="hint-mascot"></span><p><strong>${MASCOT_NAME}'s hint:</strong> ${esc(hint)}</p></div>`;
      }

      results.innerHTML = `<div class="result ${allPass ? 'result--pass' : 'result--nearly'}">
          <span class="big-mascot"></span>
          <div class="result-body">
            <p class="result-title">${title}</p>
            <div class="test-bars" aria-hidden="true">${bars}</div>
            ${body}
          </div>
        </div>`;
      const card = results.querySelector<HTMLElement>('.result')!;
      const mood = allPass ? 'happy' : 'tryagain';
      const big = tpl.content.firstElementChild!.cloneNode(true) as Element;
      big.classList.add('big');
      card.querySelector('.big-mascot')!.replaceWith(big);
      const hintSlot = card.querySelector('.hint-mascot');
      if (hintSlot) hintSlot.replaceWith(tpl.content.firstElementChild!.cloneNode(true));
      setMood(card, mood);
      setMood(document.querySelector('.hero'), mood);
      if (allPass) {
        celebrate(card);
        checkBtn.classList.remove('pulse');
      }
    }
  }

  const checkers = document.querySelectorAll<HTMLElement>('[data-checker]');
  checkers.forEach(setup);

  // Start loading C# while the student reads the big idea, so it is ready by the first Run.
  // Skipped when the browser asks to save data: then it loads on the first Run instead.
  if (checkers.length) {
    const preload = () => {
      if ((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData) return;
      checkers.forEach((c) => (c.dataset.started = '1'));
      warmUp().catch(() => {});
    };
    if ('requestIdleCallback' in window) requestIdleCallback(preload, { timeout: 3000 });
    else setTimeout(preload, 1500);
  }
</script>
