---
import BaseLayout from '../layouts/BaseLayout.astro';
import { errors, errorKind } from '../data/errors';
import { highlightHtml } from '../lib/highlight';
---

<BaseLayout title="Error decoder" description="C# error messages explained in plain English.">
  <section class="hero">
    <div class="hero-text">
      <span class="eyebrow">Help · every lesson</span>
      <h1>Error decoder</h1>
      <p class="summary">
        An error message is C# telling you exactly where it got stuck. It names the <strong>line number</strong> and the problem.
        A code like CS1002 means C# found the mistake before running anything; a name like FormatException means
        the program started, then stopped.
      </p>
    </div>
  </section>

  <div class="filter" role="group" aria-label="Show errors for">
    <span class="muted">Show:</span>
    <button type="button" data-f="all" aria-pressed="true">Everything</button>
    <button type="button" data-f="build" aria-pressed="false">Build errors (CS…)</button>
    <button type="button" data-f="runtime" aria-pressed="false">Runtime errors</button>
  </div>

  <div class="entry-list">
    {
      errors.map((e) => (
        <article class="entry" id={e.id} data-kind={errorKind(e)}>
          <span class="tag">{errorKind(e) === 'build' ? 'Build error: nothing ran' : 'Runtime error: it ran, then stopped'}</span>
          <h2 style="font-size:28px">{e.name}</h2>
          <div class="looks">{e.looksLike}</div>
          <p>{e.meaning}</p>
          <div class="before-after">
            <figure>
              <figcaption>Broken</figcaption>
              <pre class="code"><code set:html={highlightHtml(e.broken)} /></pre>
            </figure>
            <figure>
              <figcaption>Fixed</figcaption>
              <pre class="code"><code set:html={highlightHtml(e.fixed)} /></pre>
            </figure>
          </div>
          <div>
            <strong>Check:</strong>
            <ul>
              {e.check.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-f]'));
  const entries = Array.from(document.querySelectorAll<HTMLElement>('.entry'));
  const apply = (f: string) => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.f === f)));
    entries.forEach((e) => (e.hidden = f !== 'all' && e.dataset.kind !== f));
  };
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.f!)));
  if (location.hash) {
    const target = document.querySelector<HTMLElement>(location.hash);
    if (target?.hidden) apply('all');
    target?.scrollIntoView();
  }
</script>
